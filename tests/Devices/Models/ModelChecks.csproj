<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDir Condition="'$(GameDir)'==''">C:\Steam Games\steamapps\common\Sailwind</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\src\Models\DeviceModel.cs" Link="DeviceModel.cs" />
    <Compile Include="..\..\..\src\Models\DotMatrixFont.cs" Link="DotMatrixFont.cs" />
    <Compile Include="..\..\..\src\Models\MetadataMarquee.cs" Link="MetadataMarquee.cs" />
    <Compile Include="..\..\..\src\Physical\DeviceControlVisuals.cs" Link="DeviceControlVisuals.cs" />
    <Compile Include="..\..\..\src\RadioState.cs" Link="RadioState.cs" />
    <EmbeddedResource Include="..\..\..\assets\runtime\devices.json" LogicalName="SailwindRadio.Models.devices.json" />
    <Reference Include="UnityEngine" HintPath="$(GameDir)\Sailwind_Data\Managed\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)\Sailwind_Data\Managed\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameDir)\Sailwind_Data\Managed\UnityEngine.PhysicsModule.dll" />
  </ItemGroup>
</Project>
