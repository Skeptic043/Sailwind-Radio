<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDir Condition="'$(GameDir)' == ''">C:\Steam Games\steamapps\common\Sailwind</GameDir>
    <LoaderPath Condition="'$(LoaderPath)' == ''">$(MSBuildThisFileDirectory)..\..\.local\references</LoaderPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\Input\*.cs" Link="Input\%(Filename)%(Extension)" />
    <Reference Include="BepInEx" HintPath="$(LoaderPath)\BepInEx.dll" />
    <Reference Include="MonoMod.Utils" HintPath="$(LoaderPath)\MonoMod.Utils.dll" />
    <Reference Include="UnityEngine" HintPath="$(GameDir)\Sailwind_Data\Managed\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)\Sailwind_Data\Managed\UnityEngine.CoreModule.dll" />
  </ItemGroup>
</Project>
