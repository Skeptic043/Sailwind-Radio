<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLayer" Version="1.16.0" />
    <Compile Include="../../src/Audio/*.cs" />
    <Compile Include="../../src/RadioState.cs" Link="RadioState.cs" />
    <Compile Include="../../src/DeviceKind.cs" Link="DeviceKind.cs" />
    <Compile Include="AudioChecks.cs" />
    <Compile Include="UnityAudioDoubles.cs" />
    <Compile Include="FlacRoutingChecks.cs" />
    <Compile Include="M4aChecks.cs" />
    <Compile Include="StreamingChecks.cs" />
    <Compile Include="OggChecks.cs" />
    <Compile Include="ApplicationRingChecks.cs" />
    <Content Include="Fixtures/stereo-noise.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/sine-stereo.ogg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
