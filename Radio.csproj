<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SailwindRadio</AssemblyName>
    <RootNamespace>SailwindRadio</RootNamespace>
    <Version>0.5.7</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Source ZIP builds must match checkouts without inheriting an enclosing repository's metadata. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/SailwindRadio</PathMap>
    <GameDir Condition="'$(GameDir)' == ''">C:\Steam Games\steamapps\common\Sailwind</GameDir>
    <Managed>$(GameDir)\Sailwind_Data\Managed</Managed>
    <LoaderPath Condition="'$(LoaderPath)' == ''">$(MSBuildThisFileDirectory).local\references</LoaderPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLayer" Version="1.16.0" />
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="assets\runtime\devices.json" LogicalName="SailwindRadio.Models.devices.json" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Oculus.VR" HintPath="$(Managed)\Oculus.VR.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(LoaderPath)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(LoaderPath)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(Managed)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputModule" HintPath="$(Managed)\UnityEngine.InputModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(Managed)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(Managed)\UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestAudioModule" HintPath="$(Managed)\UnityEngine.UnityWebRequestAudioModule.dll" Private="false" />
  </ItemGroup>
</Project>
